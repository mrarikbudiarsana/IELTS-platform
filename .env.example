# ==============================================================================
# IELTS Platform - Environment Variables Template (.env.example)
# Copy this to .env or .env.local and fill in your real Supabase credentials.
# ==============================================================================

# Supabase API Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Supabase Database URI (PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Local Server Settings
PORT=4000
JWT_SECRET=your-secure-jwt-secret-key-here

# Cloudinary Settings (Listening Audio, Speaking Prompts, Student Audio Responses, Passage Pictures)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Frontend (Vite) Cloudinary Settings (for direct student audio/image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

